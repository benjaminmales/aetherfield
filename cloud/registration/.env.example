# aura-registration — set these in Vercel (Settings -> Environment Variables).

# Supabase project (Settings -> API). The service-role key stays server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (Aetherfield's account). Without these the app runs in dry-run mode:
# registrations work, messages are logged instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional, enables the WhatsApp tap-through on the success page:
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Shared secret for the machine endpoints (/api/registrations, /api/action,
# /api/reset). Must match CLOUD_TOKEN on the Demo Server. Generate with:
#   openssl rand -hex 24
CLOUD_API_TOKEN=

# Minutes before a registration is hard-deleted (default 30).
# SESSION_MINUTES=30

# Messages per minute cap on /api/action (default 15).
# ACTION_RATE_MAX=15

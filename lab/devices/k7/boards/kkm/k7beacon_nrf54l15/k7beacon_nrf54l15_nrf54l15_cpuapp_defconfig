# Serial / console (prj.conf may re-route the console to RTT for bring-up)
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# GPIO / PWM (RGB LED is on PWM, button on GPIO)
CONFIG_GPIO=y
CONFIG_PWM=y

# Power management
CONFIG_PM_DEVICE=y
CONFIG_NRFX_POWER=y

# CPU protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_NULL_POINTER_EXCEPTION_DETECTION_NONE=y

# Caches
CONFIG_CACHE_MANAGEMENT=y
CONFIG_EXTERNAL_CACHE=y

# GRTC syscounter for boot timestamping
CONFIG_NRF_GRTC_START_SYSCOUNTER=y

# Regulator (vregmain DCDC mode select)
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_INIT_PRIORITY=45

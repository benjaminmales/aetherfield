# GPIO / PWM: two red LEDs on PWM20 OUT0 (P1.04) and OUT1 (P2.03),
# KEY button on P0.04.
CONFIG_GPIO=y
CONFIG_PWM=y

# Console on the RXD/TXD test points via UART30 (P0.00 / P0.01).
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# CPU protection
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_NULL_POINTER_EXCEPTION_DETECTION_NONE=y

# Caches (nRF54L ICACHE)
CONFIG_CACHE_MANAGEMENT=y
CONFIG_EXTERNAL_CACHE=y

# GRTC syscounter
CONFIG_NRF_GRTC_START_SYSCOUNTER=y

# Regulator (vregmain DCDC mode select -- L3 is populated)
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_INIT_PRIORITY=45

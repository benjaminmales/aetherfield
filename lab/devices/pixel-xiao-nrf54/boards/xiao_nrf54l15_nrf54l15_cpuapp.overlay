/*
 * NeoPixel (WS2812B) hello-world for Seeed XIAO nRF54L15.
 *
 * Wiring
 *   D4  (P1.10)  -> [470R] -> DIN on the pixel
 *   BAT (+)      -> pixel VDD      (1S LiPo, 3.5-4.2V)
 *   GND          -> pixel GND      (must be common with the XIAO's GND)
 *   10uF across the pixel's VDD/GND, physically at the pixel.
 *
 * The pixel is clocked out by SPIM22 using the standard Zephyr ws2812-spi
 * driver: every WS2812 data bit becomes one 8-bit SPI frame at 4 MHz, so the
 * waveform is generated by EasyDMA and is immune to interrupt jitter. No
 * bit-banging - and no choice in the matter, since Zephyr's ws2812-gpio
 * bitbang driver is gated on nRF51/52/53/91 and does not support nRF54.
 *
 * Why instance 22 specifically
 *   On the nRF54L15 each "serial box" (20, 21, 22, ...) is ONE peripheral that
 *   can be a UARTE *or* SPIM *or* TWIM - never two at once. The SoC enforces
 *   this with a BUILD_ASSERT, so picking a busy box fails the build:
 *     box 20 -> uart20  is the console (zephyr,console / shell)
 *     box 21 -> uart21  is xiao_serial, enabled by the board
 *     box 22 -> i2c22   is xiao_i2c, and its pins are ALREADY D4/D5
 *   So box 22 is both the free one and the one that owns the pins we want.
 *   We disable i2c22 and take the box as SPIM22.
 *
 * D5 (P1.11) is burned as a dummy SCK - the nRF SPIM peripheral requires a
 * clock pin even though the WS2812 never sees it. It was i2c22's SCL anyway,
 * so no pin is lost that wasn't already spoken for. Nothing is connected to it;
 * it just wiggles at 4 MHz during an update.
 *
 * MISO is deliberately unassigned - the WS2812 is write-only, and the board's
 * own spi22_default would have put MISO on P1.09, which is uart20's TX.
 *
 * Consequence: this project cannot also use the board's I2C bus on D4/D5.
 * If this gets merged into seeedFirmware alongside the LP5012 (i2c22), the
 * pixel has to move to another box + pins.
 */

#include <zephyr/dt-bindings/led/led.h>

&gpio1 {
	status = "okay";
};

/* Release the box and the D4/D5 pins. */
&i2c22 {
	status = "disabled";
};

/*
 * The board DTS enables spi00 (xiao_spi - the D8/D9/D10 header SPI) by
 * default. We never use it, but the moment CONFIG_SPI=y is set for the
 * WS2812 the driver initialises EVERY enabled SPI instance, including this
 * one. SPIM00 lives in the nRF54L "fast" peripheral domain alongside the
 * radio's clocking, so it is not something to leave running by accident on
 * a board whose whole job is 802.15.4.
 *
 * The gateway firmware never hit this because it has no SPI at all - which
 * is exactly why the same board runs the gateway image happily and would
 * not run this one.
 */
&spi00 {
	status = "disabled";
};

&pinctrl {
	spi22_ws2812: spi22_ws2812 {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,   /* D5, dummy clock */
				<NRF_PSEL(SPIM_MOSI, 1, 10)>;  /* D4, pixel data  */
		};
	};

	spi22_ws2812_sleep: spi22_ws2812_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 11)>,
				<NRF_PSEL(SPIM_MOSI, 1, 10)>;
			low-power-enable;
		};
	};
};

&spi22 {
	status = "okay";
	pinctrl-0 = <&spi22_ws2812>;
	pinctrl-1 = <&spi22_ws2812_sleep>;
	pinctrl-names = "default", "sleep";

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";
		reg = <0>;

		/* 8 SPI bits per WS2812 bit @ 4 MHz = 2us bit period.
		 * Box 22 tops out at 8 MHz (P1 is the 8 MHz port), so 4 MHz is
		 * comfortably in range.
		 */
		spi-max-frequency = <4000000>;
		spi-one-frame = <0x70>;   /* 0.75us high */
		spi-zero-frame = <0x40>;  /* 0.25us high */

		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;

		/* WS2812B latches on >50us idle; 280us covers the -B/-V5 parts. */
		reset-delay = <280>;
	};
};

/ {
	aliases {
		led-strip = &led_strip;
	};
};

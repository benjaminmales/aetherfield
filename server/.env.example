# HTTP console + API
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# Gateway TCP listener. On the Beelink, set GATEWAY_HOST to the IP of the NIC
# facing the gateway subnet so it does not also listen on the internet side.
GATEWAY_PORT=9000
GATEWAY_HOST=0.0.0.0

# Identifies this server in the cloud. Unique per box: srv-1 .. srv-5
SERVER_ID=srv-1

# Cloud uplink (optional for local-only operation)
CLOUD_URL=
CLOUD_TOKEN=

# --- identity / messaging -----------------------------------------------
# Root URL of the aura-registration deployment (names, numbers, Twilio).
# Unset = the console works exactly as before, minus the Message buttons.
#   CLOUD_URL=https://your-app.vercel.app
# For a laptop-only rehearsal, run that app on 3100 and point here:
#   CLOUD_URL=http://localhost:3100

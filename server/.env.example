# Optional settings for the Aetherfield Demo Server.
# Copy this file to ".env" and change what you need. Everything has a default.

# Console, REST API and live feed
HTTP_PORT=3000

# Where Aura Links connect. Must match "link set server <ip> [port]" on each Link.
GATEWAY_PORT=9000

# Name of this server in the API
SERVER_ID=srv-1

# Require a key for anything that changes state through the API:
#   Authorization: Bearer <key>
# API_KEY=choose-a-long-random-string
# Also require it for reads:
# API_KEY_READS=1

# How long without hearing a device before it counts as offline (ms)
# ONLINE_MS=20000

# --- Messaging (optional) ----------------------------------------------------
# The aura-registration deployment: guests scan a QR on their Tag, register a
# name + number there, and this server can then text them. Leave unset and
# everything else works; messaging shows as not configured.
# CLOUD_URL=https://aetherfield.cloud/aura-registration
# Must match CLOUD_API_TOKEN on that deployment:
# CLOUD_TOKEN=
